# ==========================================
# 🚀 Backend Application Settings
# ==========================================
APP_NAME="Finance AI Assistant"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# ==========================================
# 🗄️ Database Configuration
# ==========================================
DATABASE_URL="sqlite:///../finance.db"

# ==========================================
# 🤖 Local Ollama AI Settings
# ==========================================
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma2:2b"
OLLAMA_COPILOT_MODEL="llama3.2:3b"

# ==========================================
# 📁 File Ingestion & Storage Paths
# ==========================================
FINANCIAL_STATEMENTS_DIR="../FinancialStatements"
TEMP_DIR="./temp"
GOOGLE_DRIVE_LEDGER_PATH="G:/My Drive/MonthlyLedger.xlsx"

# ==========================================
# 👤 Default Primary User
# ==========================================
DEFAULT_USER_EMAIL="user@local.finance"
DEFAULT_USER_NAME="Primary Investor"
DEFAULT_MONTHLY_SALARY=100000.00
DEFAULT_BASE_CURRENCY="INR"

# ==========================================
# ⚙️ Background Sync Workers
# ==========================================
MARKET_SYNC_ENABLED=true
MARKET_SYNC_INTERVAL_SECONDS=900
AUTO_DRIVE_SYNC_ENABLED=true
AUTO_DRIVE_SYNC_INTERVAL_SECONDS=300

# ==========================================
# 🔒 Security & Secrets
# ==========================================
SECRET_KEY="local-dev-secret-key-finance-assistant"
SESSION_TTL_HOURS=24

# ==========================================
# 🔌 External Integrations (Optional)
# ==========================================
GMAIL_CLIENT_SECRETS_FILE="credentials.json"
ZERODHA_API_KEY=""
ZERODHA_API_SECRET=""
